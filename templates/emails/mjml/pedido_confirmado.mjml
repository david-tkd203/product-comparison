<mjml>
  <mj-head>
    <mj-title>Pedido Confirmado | Siyash Perfumería</mj-title>
    <mj-font name="Playfair Display" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Helvetica Neue, Arial, sans-serif" />
      <mj-text font-size="13px" color="#333333" line-height="20px" />
      <mj-section background-color="#ffffff" padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      .serif-title { font-family: 'Playfair Display', Georgia, serif !important; letter-spacing: 1px; }
      .item-table th { text-align: left; padding: 8px 0; border-bottom: 2px solid #111111; font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: #78716c; }
      .item-table td { padding: 10px 0; border-bottom: 1px solid #f5f5f4; font-size: 12px; color: #1c1917; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f5f5f4">

    <!-- Brand Header -->
    <mj-section background-color="#000000" padding="22px 20px 16px 20px" border-bottom="1px solid #1c1917">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="150px" align="center" padding="0" href="https://siyash.cl/" />
        <mj-text align="center" color="#a8a29e" font-size="8px" padding-top="8px" text-transform="uppercase" letter-spacing="3px" font-weight="500">
          CONFIRMACIÓN DE COMPRA
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero Confirmation -->
    <mj-section background-color="#ffffff" padding="24px 25px 14px 25px">
      <mj-column width="100%">
        <mj-text align="center" font-size="10px" color="#15803d" font-weight="600" text-transform="uppercase" letter-spacing="2px" padding-bottom="4px">
          &#10003; PEDIDO REGISTRADO EXITOSAMENTE
        </mj-text>
        <mj-text align="center" font-size="22px" font-weight="400" color="#111111" line-height="28px">
          <span class="serif-title">Gracias por tu compra</span>
        </mj-text>
        <mj-text align="center" font-size="13px" color="#57534e" line-height="20px" padding-top="8px">
          Hola <strong>{{ nombre if nombre else 'Cliente' }}</strong>, recibimos tu orden <strong>#{{ order_id if order_id else '0000' }}</strong>. Estamos preparando tus fragancias con riguroso control de calidad y autenticidad garantizada.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Points Earned Highlight -->
    {% if puntos_ganados and puntos_ganados > 0 %}
    <mj-section background-color="#ffffff" padding="0 25px 12px 25px">
      <mj-column width="100%">
        <mj-table padding="10px 14px" css-class="bonus-box" container-background-color="#fafaf9">
          <tr>
            <td style="font-size: 20px; width: 32px; vertical-align: middle;">⭐</td>
            <td style="vertical-align: middle; padding-left: 8px;">
              <span style="font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: #78716c; font-weight: 600;">Puntos Siyash Ganados: </span>
              <strong style="font-size: 14px; color: #111111;">+{{ puntos_ganados }} puntos</strong>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
    {% endif %}

    <!-- Order Items Breakdown -->
    <mj-section background-color="#ffffff" padding="5px 25px 15px 25px">
      <mj-column width="100%">
        <mj-text font-size="10px" color="#78716c" text-transform="uppercase" letter-spacing="2px" font-weight="600" padding-bottom="6px">
          Detalle de tu Selección
        </mj-text>
        <mj-table css-class="item-table" padding="0">
          <thead>
            <tr>
              <th style="width: 60%;">Fragancia</th>
              <th style="width: 15%; text-align: center;">Cant.</th>
              <th style="width: 25%; text-align: right;">Precio</th>
            </tr>
          </thead>
          <tbody>
            {% if items %}
              {% for it in items %}
              <tr>
                <td>
                  <div style="font-weight: 600; color: #111111;">{{ it.nombre }}</div>
                  {% if it.linea %}
                  <div style="font-size: 10px; color: #a8a29e; text-transform: uppercase; letter-spacing: 1px;">{{ it.linea }}</div>
                  {% endif %}
                </td>
                <td style="text-align: center; color: #57534e;">{{ it.qty }}</td>
                <td style="text-align: right; font-weight: 600; color: #111111;">
                  {% if it.precio == 0 %}
                    <span style="color: #15803d; font-weight: bold; text-transform: uppercase; font-size: 10px;">GRATIS (PREMIO)</span>
                  {% else %}
                    ${{ "{:,}".format(it.precio * it.qty).replace(',', '.') }}
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="3" style="text-align: center; color: #a8a29e; padding: 15px 0;">Detalle no disponible</td>
              </tr>
            {% endif %}
          </tbody>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Totals Summary -->
    <mj-section background-color="#ffffff" padding="0px 25px 20px 25px">
      <mj-column width="100%">
        <mj-table padding="0">
          {% if descuento and descuento > 0 %}
          <tr>
            <td style="padding: 4px 0; font-size: 12px; color: #78716c;">Subtotal</td>
            <td style="padding: 4px 0; font-size: 12px; text-align: right; color: #1c1917;">${{ "{:,}".format(total + descuento).replace(',', '.') }}</td>
          </tr>
          <tr>
            <td style="padding: 4px 0; font-size: 12px; color: #15803d; font-weight: 600;">Descuento Cupón ({{ cupon_codigo }})</td>
            <td style="padding: 4px 0; font-size: 12px; text-align: right; color: #15803d; font-weight: 600;">-${{ "{:,}".format(descuento).replace(',', '.') }}</td>
          </tr>
          {% endif %}
          <tr>
            <td style="padding: 10px 0 0 0; font-size: 14px; font-weight: 700; color: #111111; border-top: 2px solid #111111; text-transform: uppercase; letter-spacing: 1px;">Total Pagado</td>
            <td style="padding: 10px 0 0 0; font-size: 18px; font-weight: 700; text-align: right; color: #111111; border-top: 2px solid #111111;">
              <span class="serif-title">${{ "{:,}".format(total).replace(',', '.') if total else '$0' }}</span>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Shipping & Next Steps -->
    <mj-section background-color="#fafaf9" padding="18px 25px 20px 25px" border-top="1px solid #e7e5e4">
      <mj-column width="100%">
        <mj-text font-size="10px" color="#78716c" text-transform="uppercase" letter-spacing="2px" font-weight="600" padding-bottom="4px">
          Despacho y Seguimiento
        </mj-text>
        <mj-text font-size="12px" color="#57534e" line-height="18px">
          Recibirás el código de seguimiento de Starken/Chilexpress apenas sea despachado. Todos los envíos viajan protegidos con embalaje térmico especial.
        </mj-text>
        <mj-button background-color="#111111" color="#ffffff" font-size="10px" font-weight="600" letter-spacing="2px" text-transform="uppercase" inner-padding="11px 24px" href="https://siyash.cl/cliente/cuenta" border-radius="0px" padding-top="14px">
          VER MI PEDIDO EN SIYASH.CL &rarr;
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Compact Footer -->
    <mj-section background-color="#0a0a0a" padding="22px 20px 18px 20px" border-top="1px solid #1c1917">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="100px" align="center" padding="0 0 10px 0" href="https://siyash.cl/" />
        <mj-text align="center" font-size="10px" color="#a8a29e" padding-top="2px" line-height="16px">
          Santiago de Chile &bull; contacto@siyash.cl &bull; WhatsApp +56 9 3223 8816
        </mj-text>
        <mj-divider border-width="1px" border-style="solid" border-color="#262626" width="60%" padding="12px 0" />
        <mj-text align="center" font-size="9px" color="#737373">
          &copy; 2026 Siyash Perfumería. Todos los derechos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>