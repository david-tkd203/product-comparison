<mjml>
  <mj-head>
    <mj-title>¿Olvidaste algo especial en tu bolsa? | Siyash Perfumería</mj-title>
    <mj-font name="Cormorant Garamond" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="13px" color="#2d2d2e" line-height="22px" />
      <mj-section background-color="#ffffff" padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-serif { font-family: 'Cormorant Garamond', Garamond, 'Hoefler Text', 'Times New Roman', Georgia, serif !important; }
      .brand-sans { font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
      .tracking-luxury { letter-spacing: 3px !important; }
      .cart-table th { text-align: left; padding: 8px 0; border-bottom: 2px solid #000000; font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: #797979; font-weight: 600; }
      .cart-table td { padding: 10px 0; border-bottom: 1px solid #f6f6f6; font-size: 12px; color: #2d2d2e; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6f6f6">

    <!-- Brand Header -->
    <mj-section background-color="#000000" padding="24px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="140px" align="center" padding="0" href="https://siyash.cl/" />
        <mj-text align="center" color="#a8a8a8" font-size="8px" padding-top="10px" text-transform="uppercase" letter-spacing="3px" font-weight="500">
          ALTA PERFUMERÍA &bull; SANTIAGO DE CHILE
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#ffffff" padding="28px 25px 12px 25px">
      <mj-column width="100%">
        <mj-text align="center" padding-bottom="4px">
          <span style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #797979; font-weight: 600; border-bottom: 1px solid #e2e2e2; padding-bottom: 3px;">TU SELECCIÓN &bull; BOLSA DE COMPRAS</span>
        </mj-text>
        <mj-text align="center" font-size="24px" font-weight="500" color="#000000" line-height="30px" padding-top="12px">
          <span class="brand-serif">¿Olvidaste algo especial en tu bolsa?</span>
        </mj-text>
        <mj-text align="center" font-size="13px" color="#5f5f5f" line-height="21px" font-weight="300" padding-top="8px">
          Hola <strong>{{ nombre if nombre else 'amante de las fragancias' }}</strong>. Notamos que dejaste piezas exclusivas reservadas en tu bolsa de compras. Como las ediciones de alta perfumería cuentan con stock dinámico, las guardamos temporalmente para ti.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Cart Items Table -->
    {% if items %}
    <mj-section background-color="#ffffff" padding="10px 25px 16px 25px">
      <mj-column width="100%">
        <mj-text font-size="10px" color="#797979" text-transform="uppercase" letter-spacing="2px" font-weight="600" padding-bottom="6px">
          Productos en tu bolsa
        </mj-text>
        <mj-table css-class="cart-table" padding="0">
          <thead>
            <tr>
              <th style="width: 65%;">Fragancia</th>
              <th style="width: 15%; text-align: center;">Cant.</th>
              <th style="width: 20%; text-align: right;">Precio</th>
            </tr>
          </thead>
          <tbody>
            {% for it in items %}
            <tr>
              <td>
                <div style="font-weight: 600; color: #000000;">{{ it.nombre }}</div>
                {% if it.linea %}
                <div style="font-size: 10px; color: #a8a8a8; text-transform: uppercase; letter-spacing: 1px;">{{ it.linea }}</div>
                {% endif %}
              </td>
              <td style="text-align: center; color: #5f5f5f;">{{ it.qty if it.qty else 1 }}</td>
              <td style="text-align: right; font-weight: 600; color: #000000;">
                {% if it.precio %}
                  ${{ "{:,}".format(it.precio).replace(',', '.') }}
                {% else %}
                  -
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </mj-table>
      </mj-column>
    </mj-section>
    {% endif %}

    <!-- CTA Section -->
    <mj-section background-color="#ffffff" padding="8px 25px 24px 25px">
      <mj-column width="100%">
        <mj-button background-color="#000000" color="#ffffff" font-size="11px" font-weight="500" letter-spacing="2.5px" text-transform="uppercase" inner-padding="14px 34px" href="{{ cart_url if cart_url else 'https://siyash.cl/perfumes' }}" border-radius="0px">
          RECUPERAR MI BOLSA &rarr;
        </mj-button>
        <mj-text align="center" font-size="11px" color="#797979" padding-top="14px" line-height="18px">
          Despacho express a todo Chile &bull; 100% perfumes originales garantizados &bull; Acumulas Puntos Siyash en cada compra.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#000000" padding="22px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="95px" align="center" padding="0 0 10px 0" href="https://siyash.cl/" />
        <mj-text align="center" font-size="10px" color="#a8a8a8" padding-top="2px" line-height="16px">
          Venta de Perfumes Originales por Mayor y Detalle &bull; Envíos a todo Chile<br/>
          Santiago de Chile &bull; contacto@siyash.cl &bull; WhatsApp +56 9 3223 8816
        </mj-text>
        <mj-divider border-width="1px" border-style="solid" border-color="#2d2d2e" width="50%" padding="12px 0" />
        <mj-text align="center" font-size="9px" color="#797979" line-height="14px">
          Recibes este recordatorio por tu actividad reciente en la tienda oficial siyash.cl.<br/>
          &copy; 2026 Siyash Perfumería. Todos los derechos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
