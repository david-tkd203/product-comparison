<mjml>
  <mj-head>
    <mj-title>{{ titulo_comunicado if titulo_comunicado else 'Comunicado Oficial' }} | Siyash Perfumería</mj-title>
    <mj-font name="Cormorant Garamond" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="13px" color="#2d2d2e" line-height="22px" />
      <mj-section background-color="#ffffff" padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-serif { font-family: 'Cormorant Garamond', Garamond, 'Hoefler Text', 'Times New Roman', Georgia, serif !important; }
      .brand-sans { font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
      .tracking-luxury { letter-spacing: 3px !important; }
      .comunicado-body p { margin: 0 0 14px 0; }
      .comunicado-body strong { color: #000000; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6f6f6">

    <!-- Brand Header -->
    <mj-section background-color="#000000" padding="24px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="140px" align="center" padding="0" href="https://siyash.cl/" />
        <mj-text align="center" color="#a8a8a8" font-size="8px" padding-top="10px" text-transform="uppercase" letter-spacing="3px" font-weight="500">
          ALTA PERFUMERÍA &bull; SANTIAGO DE CHILE
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#ffffff" padding="28px 25px 12px 25px">
      <mj-column width="100%">
        <mj-text align="center" padding-bottom="4px">
          <span style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #797979; font-weight: 600; border-bottom: 1px solid #e2e2e2; padding-bottom: 3px;">
            {{ tag_comunicado if tag_comunicado else 'COMUNICADO OFICIAL &bull; SIYASH PERFUMERÍA' }}
          </span>
        </mj-text>
        <mj-text align="center" font-size="24px" font-weight="500" color="#000000" line-height="30px" padding-top="12px">
          <span class="brand-serif">{{ titulo_comunicado if titulo_comunicado else 'Información Importante' }}</span>
        </mj-text>
        {% if subtitulo %}
        <mj-text align="center" font-size="13px" color="#797979" line-height="20px" padding-top="4px">
          {{ subtitulo }}
        </mj-text>
        {% endif %}
      </mj-column>
    </mj-section>

    <!-- Communicado Body -->
    <mj-section background-color="#ffffff" padding="10px 25px 20px 25px">
      <mj-column width="100%">
        {% if nombre %}
        <mj-text font-size="13px" color="#2d2d2e" padding-bottom="10px">
          Estimado/a <strong>{{ nombre }}</strong>,
        </mj-text>
        {% endif %}
        <mj-text font-size="13px" color="#5f5f5f" line-height="22px" css-class="comunicado-body">
          {% if cuerpo_comunicado %}
            {{ cuerpo_comunicado | safe }}
          {% else %}
            Te informamos sobre las últimas novedades y actualizaciones operativas de Siyash Perfumería. Nuestro compromiso es brindarte la mejor experiencia en perfumería fina, con atención personalizada y despachos garantizados en todo el país.
          {% endif %}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Optional CTA Button -->
    {% if cta_url %}
    <mj-section background-color="#ffffff" padding="4px 25px 28px 25px">
      <mj-column width="100%">
        <mj-button background-color="#000000" color="#ffffff" font-size="11px" font-weight="500" letter-spacing="2.5px" text-transform="uppercase" inner-padding="14px 34px" href="{{ cta_url }}" border-radius="0px">
          {{ cta_texto if cta_texto else 'CONOCER MÁS &rarr;' }}
        </mj-button>
      </mj-column>
    </mj-section>
    {% else %}
    <mj-section background-color="#ffffff" padding="0 25px 24px 25px">
      <mj-column width="100%">
        <mj-text align="center" font-size="11px" color="#a8a8a8">
          Para consultas adicionales, comunícate con nosotros a través de <a href="mailto:contacto@siyash.cl" style="color: #000000; text-decoration: underline;">contacto@siyash.cl</a>
        </mj-text>
      </mj-column>
    </mj-section>
    {% endif %}

    <!-- Footer -->
    <mj-section background-color="#000000" padding="22px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="95px" align="center" padding="0 0 10px 0" href="https://siyash.cl/" />
        <mj-text align="center" font-size="10px" color="#a8a8a8" padding-top="2px" line-height="16px">
          Venta de Perfumes Originales por Mayor y Detalle &bull; Envíos a todo Chile<br/>
          Santiago de Chile &bull; contacto@siyash.cl &bull; WhatsApp +56 9 3223 8816
        </mj-text>
        <mj-divider border-width="1px" border-style="solid" border-color="#2d2d2e" width="50%" padding="12px 0" />
        <mj-text align="center" font-size="9px" color="#797979" line-height="14px">
          Comunicación oficial de Siyash Perfumería.<br/>
          &copy; 2026 Siyash Perfumería. Todos los derechos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
