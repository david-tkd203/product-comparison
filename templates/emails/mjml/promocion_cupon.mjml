<mjml>
  <mj-head>
    <mj-title>{{ titulo_promo if titulo_promo else 'Beneficio Exclusivo' }} | Siyash Perfumería</mj-title>
    <mj-font name="Cormorant Garamond" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="13px" color="#2d2d2e" line-height="20px" />
      <mj-section background-color="#ffffff" padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-serif { font-family: 'Cormorant Garamond', Garamond, 'Hoefler Text', 'Times New Roman', Georgia, serif !important; }
      .brand-sans { font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
      .coupon-card { background-color: #000000; color: #ffffff; font-family: 'Courier New', monospace; font-size: 20px; font-weight: 700; letter-spacing: 3px; padding: 12px 20px; border: 1px solid #000000; display: inline-block; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6f6f6">

    <!-- Brand Header -->
    <mj-section background-color="#000000" padding="24px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="140px" align="center" padding="0" href="https://siyash.cl/" />
        <mj-text align="center" color="#a8a8a8" font-size="8px" padding-top="10px" text-transform="uppercase" letter-spacing="3px" font-weight="500">
          VENTA EXCLUSIVA &bull; CUPÓN DE DESCUENTO
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero Promo Section -->
    <mj-section background-color="#ffffff" padding="26px 25px 12px 25px">
      <mj-column width="100%">
        <mj-text align="center" padding-bottom="4px">
          <span style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #797979; font-weight: 600; border-bottom: 1px solid #e2e2e2; padding-bottom: 3px;">{{ tag_promo if tag_promo else 'BENEFICIO EXCLUSIVO' }}</span>
        </mj-text>
        <mj-text align="center" font-size="24px" font-weight="500" color="#000000" line-height="30px" padding-top="12px">
          <span class="brand-serif">{{ titulo_promo if titulo_promo else 'Un beneficio pensado para ti' }}</span>
        </mj-text>
        <mj-text align="center" font-size="13px" color="#5f5f5f" line-height="20px" padding-top="8px">
          Hola <strong>{{ nombre if nombre else 'Cliente VIP' }}</strong>. Tienes acceso a un descuento especial en nuestra colección de fragancias importadas originales.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Coupon Display Box (Monochrome) -->
    <mj-section background-color="#f6f6f6" padding="20px 25px" border-top="1px solid #e2e2e2" border-bottom="1px solid #e2e2e2">
      <mj-column width="100%">
        <mj-text align="center" font-size="10px" color="#797979" text-transform="uppercase" letter-spacing="2px" padding-bottom="4px" font-weight="600">
          BENEFICIO DISPONIBLE
        </mj-text>
        <mj-text align="center" font-size="22px" font-weight="600" color="#000000" padding-bottom="10px">
          <span class="brand-serif">{{ valor_descuento if valor_descuento else '15% DE DESCUENTO' }}</span>
        </mj-text>
        <mj-text align="center">
          <span class="coupon-card">{{ codigo_cupon if codigo_cupon else 'CYBERSIYASH' }}</span>
        </mj-text>
        <mj-text align="center" font-size="10px" color="#a8a8a8" padding-top="10px">
          {% if minimo_compra %}Válido en compras sobre {{ minimo_compra }}. {% endif %}
          {% if fecha_expiracion %}Vence el {{ fecha_expiracion }}.{% endif %}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Categories -->
    <mj-section background-color="#ffffff" padding="16px 20px 10px 20px">
      <mj-column width="50%" padding="6px 10px">
        <mj-text align="center" font-size="10px" font-weight="600" text-transform="uppercase" color="#000000" letter-spacing="1.5px">
          PERFUMES DE DISEÑADOR
        </mj-text>
        <mj-text align="center" font-size="10px" color="#797979" line-height="15px" padding-top="2px">
          Armani, Azzaro, Burberry, CH y más.
        </mj-text>
      </mj-column>
      <mj-column width="50%" padding="6px 10px">
        <mj-text align="center" font-size="10px" font-weight="600" text-transform="uppercase" color="#000000" letter-spacing="1.5px">
          PERFUMERÍA ÁRABE & NICHO
        </mj-text>
        <mj-text align="center" font-size="10px" color="#797979" line-height="15px" padding-top="2px">
          Lattafa, Armaf, Afnan, Al Haramain.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section background-color="#ffffff" padding="4px 25px 26px 25px">
      <mj-column width="100%">
        <mj-button background-color="#000000" color="#ffffff" font-size="11px" font-weight="500" letter-spacing="2px" text-transform="uppercase" inner-padding="13px 30px" href="https://siyash.cl/perfumes" border-radius="0px">
          APLICAR CUPÓN Y COMPRAR &rarr;
        </mj-button>
        <mj-text align="center" font-size="10px" color="#a8a8a8" padding-top="10px">
          Envíos a todo Chile con embalaje térmico y seguro.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#000000" padding="22px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="95px" align="center" padding="0 0 10px 0" href="https://siyash.cl/" />
        <mj-text align="center" font-size="10px" color="#a8a8a8" padding-top="2px" line-height="16px">
          Santiago de Chile &bull; contacto@siyash.cl &bull; WhatsApp +56 9 3223 8816
        </mj-text>
        <mj-divider border-width="1px" border-style="solid" border-color="#2d2d2e" width="50%" padding="12px 0" />
        <mj-text align="center" font-size="9px" color="#797979">
          &copy; 2026 Siyash Perfumería. Todos los derechos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>