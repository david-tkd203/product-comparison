<mjml>
  <mj-head>
    <mj-title>Pedido Entregado con Éxito | Siyash Perfumería</mj-title>
    <mj-font name="Cormorant Garamond" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="13px" color="#2d2d2e" line-height="22px" />
      <mj-section background-color="#ffffff" padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      .brand-serif { font-family: 'Cormorant Garamond', Garamond, 'Hoefler Text', 'Times New Roman', Georgia, serif !important; }
      .brand-sans { font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
      .tracking-luxury { letter-spacing: 3px !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6f6f6">

    <!-- Brand Header -->
    <mj-section background-color="#000000" padding="24px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="140px" align="center" padding="0" href="https://siyash.cl/" />
        <mj-text align="center" color="#a8a8a8" font-size="8px" padding-top="10px" text-transform="uppercase" letter-spacing="3px" font-weight="500">
          ALTA PERFUMERÍA &bull; SANTIAGO DE CHILE
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#ffffff" padding="28px 25px 12px 25px">
      <mj-column width="100%">
        <mj-text align="center" padding-bottom="4px">
          <span style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #797979; font-weight: 600; border-bottom: 1px solid #e2e2e2; padding-bottom: 3px;">ENTREGA CONFIRMADA &bull; ORDEN #{{ order_id if order_id else '0000' }}</span>
        </mj-text>
        <mj-text align="center" font-size="24px" font-weight="500" color="#000000" line-height="30px" padding-top="12px">
          <span class="brand-serif">Tu fragancia ha sido entregada</span>
        </mj-text>
        <mj-text align="center" font-size="13px" color="#5f5f5f" line-height="21px" font-weight="300" padding-top="8px">
          Hola <strong>{{ nombre if nombre else 'estimado cliente' }}</strong>. El transportista nos ha confirmado la entrega exitosa de tu orden <strong>#{{ order_id if order_id else '0000' }}</strong>{% if fecha_entrega %} el día <strong>{{ fecha_entrega }}</strong>{% endif %}.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Fragrance Care Tips (Luxury Box) -->
    <mj-section background-color="#ffffff" padding="8px 25px 16px 25px">
      <mj-column width="100%">
        <mj-table padding="16px 18px" container-background-color="#f6f6f6">
          <tr>
            <td style="font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #000000; font-weight: 600; padding-bottom: 8px;">
              CUIDADO Y DISFRUTE DE TU PERFUME
            </td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #5f5f5f; line-height: 20px;">
              1. <strong>Reposo tras el transporte:</strong> Deja la botella a temperatura ambiente unas horas para que sus moléculas y aceites esenciales se estabilicen antes de la primera atomización.<br/>
              2. <strong>Conservación:</strong> Mantén tu fragancia en un lugar fresco y seco, lejos del vapor y de la luz solar directa.<br/>
              3. <strong>Aplicación:</strong> Aplica sobre puntos de pulso (cuello, muñecas, clavícula) sin frotar, para mantener la pirámide olfativa intacta.
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Loyalty & CTA -->
    <mj-section background-color="#ffffff" padding="4px 25px 24px 25px">
      <mj-column width="100%">
        <mj-text align="center" font-size="12px" color="#5f5f5f" line-height="20px" padding-bottom="14px">
          Tus <strong>Puntos Siyash</strong> ya se encuentran acreditados en tu cuenta listos para tus próximos beneficios.
        </mj-text>
        <mj-button background-color="#000000" color="#ffffff" font-size="11px" font-weight="500" letter-spacing="2.5px" text-transform="uppercase" inner-padding="14px 34px" href="{{ cuenta_url if cuenta_url else 'https://siyash.cl/cliente/cuenta' }}" border-radius="0px">
          VER MI CUENTA Y PUNTOS &rarr;
        </mj-button>
        <mj-text align="center" font-size="10px" color="#797979" padding-top="14px">
          ¿Tienes algún comentario sobre tu entrega? Escríbenos directamente a <a href="mailto:contacto@siyash.cl" style="color: #000000; text-decoration: underline;">contacto@siyash.cl</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#000000" padding="22px 20px 18px 20px">
      <mj-column width="100%">
        <mj-image src="https://siyash.cl/static/img/LogoSiyash-02-t.png" alt="Siyash Perfumería" width="95px" align="center" padding="0 0 10px 0" href="https://siyash.cl/" />
        <mj-text align="center" font-size="10px" color="#a8a8a8" padding-top="2px" line-height="16px">
          Venta de Perfumes Originales por Mayor y Detalle &bull; Envíos a todo Chile<br/>
          Santiago de Chile &bull; contacto@siyash.cl &bull; WhatsApp +56 9 3223 8816
        </mj-text>
        <mj-divider border-width="1px" border-style="solid" border-color="#2d2d2e" width="50%" padding="12px 0" />
        <mj-text align="center" font-size="9px" color="#797979" line-height="14px">
          Confirmación de entrega de Siyash Perfumería.<br/>
          &copy; 2026 Siyash Perfumería. Todos los derechos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
