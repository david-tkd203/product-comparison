# Copiá este archivo a .env y ajustá los valores
# cp .env.example .env

# Flask
FLASK_SECRET_KEY=cambiar-en-produccion

# MySQL (deben coincidir con el servicio db en docker-compose.yml)
MYSQL_HOST=db
MYSQL_USER=perfumes
MYSQL_PASSWORD=perfumes
MYSQL_DATABASE=perfumes

# Cloudflare Tunnel
TUNNEL_URL_FILE=/app/tunnel/url.txt
